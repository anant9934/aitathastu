{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run db:migrate && npm run build",
  "installCommand": "npm ci --include=dev",
  "crons": [
    {
      "path": "/api/cron/cleanup-stuck-syncs",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/sync-retry",
      "schedule": "30 4 * * *"
    }
  ]
}
