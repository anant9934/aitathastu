# ==============================================================================
# AI TATHASTU — ENVIRONMENT CONFIGURATION TEMPLATE
# Phase D Production Readiness Specification
#
# INSTRUCTIONS:
# 1. Copy this file to '.env.local' for local development or set in your deployment
#    platform (e.g. Vercel, Railway, Neon).
# 2. NEVER commit actual production secrets to source control.
# 3. NEVER prefix secret keys with NEXT_PUBLIC_ (which leaks them to client bundles).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE & APP CONFIGURATION
# ------------------------------------------------------------------------------

# [REQUIRED in PRODUCTION]
# PostgreSQL connection string (Neon, Supabase, RDS). If omitted in local dev,
# the application uses embedded PGlite in .pgdata.
DATABASE_URL=postgresql://user:password@host.pooler.neon.tech/aitathastu?sslmode=require

# [REQUIRED in PRODUCTION]
# Public canonical URL of the deployed application (used for OAuth callbacks and CSRF checks).
APP_BASE_URL=https://aitathastu.example.edu

# [REQUIRED in PRODUCTION]
# Secret used to sign short-lived app handoff tokens (Study LPU, Padho Code, MentorMaze).
HANDOFF_SIGNING_SECRET=replace_with_64_character_cryptographically_secure_random_hex

# [OPTIONAL / DEFAULT: production in prod, development in dev]
NODE_ENV=production


# ------------------------------------------------------------------------------
# 2. PILOT CONTROLS & FEATURE FLAGS
# ------------------------------------------------------------------------------

# [OPTIONAL: default false]
# Set to 'true' to restrict registrations to controlled pilot invitees.
PILOT_MODE=false

# [OPTIONAL: default false]
# When true, signups require a valid pilot code from PILOT_INVITE_CODES.
INVITE_CODE_REQUIRED=false

# [OPTIONAL: comma-separated list of valid invitation codes]
PILOT_INVITE_CODES=TATHASTU-PILOT-2026,LPU-PILOT-2026,AI-COHORT-2026

# [OPTIONAL: default false]
# Live external flags (require live production tenant credentials)
ENABLE_GITHUB_LIVE=false
ENABLE_STUDY_LPU_LIVE=false
ENABLE_PADHO_CODE_LIVE=false
ENABLE_ERIS_LIVE=false
ENABLE_MENTORMAZE_LIVE=false
ENABLE_LLM_EORA=true


# ------------------------------------------------------------------------------
# 3. GITHUB INTEGRATION CREDENTIALS
# ------------------------------------------------------------------------------

# [OPTIONAL: Required only when live GitHub App / OAuth is connected]
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=replace_with_secure_random_webhook_secret_32_chars


# ------------------------------------------------------------------------------
# 4. FIRST-PARTY ECOSYSTEM CREDENTIALS (PARTNER APPS)
# ------------------------------------------------------------------------------

# [OPTIONAL: Provisioned per institutional tenant]
INTEGRATION_STUDY_LPU_SECRET=
INTEGRATION_PADHO_CODE_SECRET=
INTEGRATION_ERIS_SECRET=
INTEGRATION_MENTORMAZE_SECRET=


# ------------------------------------------------------------------------------
# 5. MULTI-PROVIDER AI ADAPTERS (TIERED POOL WITH DETERMINISTIC FALLBACK)
# ------------------------------------------------------------------------------

# [OPTIONAL: If omitted, system falls back to zero-LLM deterministic rules]
# Multiple comma-separated keys supported for automatic rotation and key pool load-balancing.
GEMINI_API_KEYS=
GEMINI_API_KEY=

GROQ_API_KEYS=
GROQ_API_KEY=

OPENROUTER_API_KEYS=
OPENROUTER_API_KEY=

CEREBRAS_API_KEYS=
CEREBRAS_API_KEY=

MISTRAL_API_KEYS=
MISTRAL_API_KEY=

SAMBANOVA_API_KEYS=
SAMBANOVA_API_KEY=


# ------------------------------------------------------------------------------
# 6. DEVELOPMENT & TESTING ONLY
# ------------------------------------------------------------------------------

# [DEVELOPMENT ONLY]
# Forces PGlite to run in-memory without creating a local disk folder.
# PGLITE_IN_MEMORY=false
