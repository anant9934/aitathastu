# AI Tathastu — environment variables (Next.js app)
# Every variable below is read by the code. Copy to .env for local dev; set the
# same names in Vercel (Project Settings > Environment Variables) for production.
# Never prefix a secret with NEXT_PUBLIC_.
# The Python extractor has its own settings: see render.yaml and
# services/resume-extractor/app/config.py.

# ---------------------------------------------------------------- Database
# [required in production] Postgres URL (Neon). Empty in dev = embedded PGlite in .pgdata.
DATABASE_URL=
# [optional] auto | postgres | pglite. Default: postgres in production, auto otherwise.
DATABASE_MODE=
# [optional] Force the Neon HTTP driver for a non-neon.tech host: neon-http.
DATABASE_TRANSPORT=
# [optional] Run DDL at startup. Default false in production, true in dev. Production: run `npm run db:migrate` instead.
DATABASE_AUTO_MIGRATE=
# [optional, dev] PGlite data directory (default ./.pgdata) / in-memory DB for tests.
PGLITE_DATA_DIR=
PGLITE_IN_MEMORY=

# ---------------------------------------------------------------- App
# [required in production] Canonical public URL; used for OAuth redirect URIs and CSRF origin checks.
APP_BASE_URL=http://localhost:3000
# [optional] development | production | test.
NODE_ENV=development
# [optional] Set to "staging" for a staging deploy (secret audit treats it as staging).
APP_ENV=

# ---------------------------------------------------------------- Security gate
# In production CV upload / GitHub import return 503 unless ALL of these are set (each >= 32 chars).
CORE_INGESTION_SECURITY_APPROVED=false
SESSION_SECRET=
HANDOFF_SIGNING_SECRET=
GITHUB_WEBHOOK_SECRET=
EXTERNAL_TOKEN_ENCRYPTION_KEY=
# [optional] Previous encryption key, only while rotating EXTERNAL_TOKEN_ENCRYPTION_KEY.
EXTERNAL_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# [required in production] Bearer secret for /api/cron/cleanup-stuck-syncs (Vercel Cron).
CRON_SECRET=

# ---------------------------------------------------------------- Resume extractor (Render)
# [required for scanned PDFs] Base URL of the Python extractor. Unset = scanned PDFs fail with OCR_SERVICE_NOT_CONFIGURED.
RESUME_EXTRACTOR_URL=
# [required with RESUME_EXTRACTOR_URL] Must equal EXTRACTOR_API_TOKEN on the extractor.
EXTRACTOR_API_TOKEN=
# [optional] Separate verifier credential; must equal EXTRACTOR_VERIFIER_TOKEN on the extractor.
EXTRACTOR_VERIFIER_TOKEN=

# ---------------------------------------------------------------- OAuth & GitHub
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth app (needed for "Connect with GitHub"; callback: $APP_BASE_URL/api/auth/github/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App for explicitly selected private repositories (read-only Metadata + Contents).
# Set the App Setup URL to: $APP_BASE_URL/api/auth/github/app-callback
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Store the PEM securely; literal \\n newlines are supported.
GITHUB_APP_PRIVATE_KEY=

# [recommended] Server token for public GitHub API reads. Without it all users share 60 requests/hour per egress IP.
GITHUB_TOKEN=

# ---------------------------------------------------------------- Rate limiting
# [recommended in production] Upstash Redis REST. Without it limits are per serverless instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- Pilot & feature flags
PILOT_MODE=false
INVITE_CODE_REQUIRED=false
# Comma-separated invite codes.
PILOT_INVITE_CODES=
ENABLE_GITHUB_LIVE=false
ENABLE_STUDY_LPU_LIVE=false
ENABLE_PADHO_CODE_LIVE=false
ENABLE_ERIS_LIVE=false
ENABLE_MENTORMAZE_LIVE=false
# EORA LLM replies (default on). CORE_DISABLE_LIVE_LLM=true forces deterministic fallback everywhere.
ENABLE_LLM_EORA=true
CORE_DISABLE_LIVE_LLM=false

# ---------------------------------------------------------------- LLM providers (active allowlist)
# Complete allowed active provider set: groq, gemini, openrouter (SambaNova, Mistral, Cerebras retired)
CLOUD_AI_PROVIDER_ORDER=groq,gemini,openrouter

# Groq (up to 5 indexed keys supported; fallback: GROQ_API_KEYS)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (up to 4 indexed keys supported; fallback: GEMINI_API_KEYS)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenRouter (up to 4 indexed keys supported; fallback: OPENROUTER_API_KEYS)
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------- Partner integrations (optional)
# Partners authenticate with DB-stored credentials; these only drive the integration status page and secret audit.
STUDY_LPU_INTEGRATION_SECRET=
PADHO_CODE_INTEGRATION_SECRET=
ERIS_INTEGRATION_SECRET=
MENTORMAZE_INTEGRATION_SECRET=

# ---------------------------------------------------------------- External Connectors (optional)
# Kaggle (up to 3 credential pairs)
KAGGLE_USERNAME_1=
KAGGLE_KEY_1=
KAGGLE_USERNAME_2=
KAGGLE_KEY_2=
KAGGLE_USERNAME_3=
KAGGLE_KEY_3=

# Apify (up to 4 tokens for approved actors: website-crawler, html-extract, json-extractor)
APIFY_TOKEN_1=
APIFY_TOKEN_2=
APIFY_TOKEN_3=
APIFY_TOKEN_4=

# Firecrawl (up to 5 keys for portfolio/website markdown extraction)
FIRECRAWL_API_KEY_1=
FIRECRAWL_API_KEY_2=
FIRECRAWL_API_KEY_3=
FIRECRAWL_API_KEY_4=
FIRECRAWL_API_KEY_5=

# Stack Exchange API (Stack Overflow public developer reputation and top tags)
STACKEXCHANGE_API_KEY=

# Set automatically by Vercel, do not set yourself: VERCEL_URL, VERCEL_ENV.
